{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://property-intelligence.example/schema/photo-point-v1.json",
  "title": "Property Intelligence Permanent Photo Point",
  "type": "object",
  "required": ["schema_name", "schema_version", "property_id", "photo_point_id", "reference_capture_id", "captures"],
  "properties": {
    "schema_name": { "const": "property-intelligence-photo-point" },
    "schema_version": { "const": 1 },
    "property_id": { "type": "string", "minLength": 1 },
    "photo_point_id": { "type": "string", "minLength": 1 },
    "reference_capture_id": { "type": "string", "minLength": 1 },
    "source_inspection_id": { "type": ["string", "null"] },
    "source_session_id": { "type": ["string", "null"] },
    "target_description": { "type": "string" },
    "notes": { "type": "string" },
    "work_zone_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capture" }
    }
  },
  "$defs": {
    "reading": {
      "type": "object",
      "required": ["availability", "value", "source"],
      "properties": {
        "availability": { "enum": ["AVAILABLE", "UNAVAILABLE"] },
        "value": {},
        "source": { "type": ["string", "null"] },
        "reliability": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["capture_id", "property_id", "photo_point_id", "capture_purpose", "captured_at", "image", "position", "orientation", "camera", "immutable"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "property_id": { "type": "string", "minLength": 1 },
        "photo_point_id": { "type": "string", "minLength": 1 },
        "capture_purpose": { "enum": ["BEFORE", "WORK", "AFTER", "MONITORING"] },
        "captured_at": { "type": "string" },
        "image": {
          "type": "object",
          "required": ["blob_id", "sha256", "immutable"],
          "properties": {
            "blob_id": { "type": "string" },
            "sha256": { "type": "string" },
            "immutable": { "const": true }
          }
        },
        "position": { "type": "object" },
        "orientation": { "type": "object" },
        "camera": { "type": "object" },
        "immutable": { "const": true }
      }
    }
  }
}
