{
  "schema_name": "property-inspector-button-inventory",
  "schema_version": "1.0",
  "app_version": "3.13.0-home-test.5.4",
  "scope": "active fixed field workflow",
  "tap_contract": [
    "immediate visible acknowledgement",
    "single action per tap",
    "durable save confirmation",
    "plain-language failure",
    "no hidden overlay interception"
  ],
  "buttons": [
    {"button_id":"reloadLatestApp","visible_label":"RELOAD LATEST APP","screen":"all field screens","event_handler":"service-worker update then reload","required_state":"none","disabled_state_reason":null,"expected_result":"latest fixed app shell reloads","saving_behavior":"evidence unchanged","failure_behavior":"diagnostic logged before reload","automated_test_name":"fixed-shell-version-and-reload"},
    {"button_id":"simpleButtonCheck","visible_label":"TEST FIELD BUTTONS","screen":"start","event_handler":"runFieldButtonCheck","required_state":"offline shell loaded","disabled_state_reason":"only while test runs","expected_result":"ALL REQUIRED BUTTONS RESPONDED or DO NOT ENTER FIELD","saving_behavior":"storage read-back test","failure_behavior":"start remains disabled","automated_test_name":"start-of-day-button-check"},
    {"button_id":"simpleStart","visible_label":"START TEST INSPECTION","screen":"start","event_handler":"startTracking","required_state":"offline ready and button check passed","disabled_state_reason":"offline or button test not ready","expected_result":"inspection and GPS start","saving_behavior":"inspection metadata saved","failure_behavior":"plain GPS/storage warning","automated_test_name":"start-gate"},
    {"button_id":"simpleTopReturn","visible_label":"SAVE & RETURN TO BUTTONS","screen":"all field screens","event_handler":"simpleReturnToFieldButtons","required_state":"none","disabled_state_reason":null,"expected_result":"current draft saved and field grid shown","saving_behavior":"active record finalized or section paused","failure_behavior":"returns to grid with warning","automated_test_name":"permanent-return-control"},
    {"button_id":"simpleTopFinish","visible_label":"FINISH","screen":"all field screens","event_handler":"renderSimpleFinish","required_state":"inspection started","disabled_state_reason":null,"expected_result":"finish choices shown","saving_behavior":"inspection remains stored","failure_behavior":"existing evidence unchanged","automated_test_name":"finish-control"},
    {"button_id":"simpleCenterMap","visible_label":"CENTER ON ME","screen":"field locator","event_handler":"renderSimpleLocator","required_state":"map loaded","disabled_state_reason":null,"expected_result":"current locator redraws","saving_behavior":"none","failure_behavior":"field capture remains usable","automated_test_name":"locator-buttons"},
    {"button_id":"simpleExpandMap","visible_label":"EXPAND MAP","screen":"field locator","event_handler":"open detailed map","required_state":"map loaded","disabled_state_reason":null,"expected_result":"large map shown","saving_behavior":"none","failure_behavior":"return control remains available","automated_test_name":"locator-buttons"},
    {"button_id":"simpleMapSection","visible_label":"MAP THIS SECTION","screen":"field grid","event_handler":"renderSectionStart","required_state":"inspection active","disabled_state_reason":null,"expected_result":"section choices shown","saving_behavior":"no evidence until start is tapped","failure_behavior":"tap diagnostic exported","automated_test_name":"section-start-screen"},
    {"button_id":"simpleAddNote","visible_label":"ADD NOTE","screen":"field grid","event_handler":"renderNoteEditor","required_state":"inspection active","disabled_state_reason":null,"expected_result":"focused multiline note editor","saving_behavior":"draft preserved until verified save","failure_behavior":"text remains with RETRY SAVE","automated_test_name":"ordinary-note-durable-save"},
    {"button_id":"saveOrdinaryNote","visible_label":"SAVE NOTE","screen":"note editor","event_handler":"verified local save","required_state":"text or purpose entered","disabled_state_reason":"only while saving","expected_result":"NOTE SAVED with ID and time","saving_behavior":"localStorage read-back verification","failure_behavior":"NOT SAVED and RETRY SAVE","automated_test_name":"ordinary-note-durable-save"},
    {"button_id":"cancelOrdinaryNote","visible_label":"CANCEL","screen":"note editor","event_handler":"return while preserving draft","required_state":"none","disabled_state_reason":null,"expected_result":"previous screen shown","saving_behavior":"unsaved draft retained","failure_behavior":"draft remains","automated_test_name":"ordinary-note-cancel"},
    {"button_id":"simpleTakePhoto","visible_label":"TAKE / ADD PHOTO","screen":"feature capture","event_handler":"simpleTakePhoto","required_state":"active feature","disabled_state_reason":"only while camera/save is busy","expected_result":"camera launches once","saving_behavior":"original and analysis copy verified","failure_behavior":"pending-photo recovery queue","automated_test_name":"photo-launch-return"},
    {"button_id":"simpleSaveReturn","visible_label":"SAVE WHAT I HAVE & RETURN TO FIELD BUTTONS","screen":"feature capture","event_handler":"simpleSaveAndReturn","required_state":"active feature","disabled_state_reason":null,"expected_result":"feature saved and grid shown","saving_behavior":"metadata saved before navigation","failure_behavior":"grid restored with warning","automated_test_name":"feature-save-return"},
    {"button_id":"sectionStartWalking","visible_label":"START MAPPING THIS SECTION","screen":"section setup","event_handler":"sectionMappingTools.startSection","required_state":"current or last saved GPS","disabled_state_reason":"only while start runs","expected_result":"SECTION STARTED AND SAVING","saving_behavior":"section ID, GPS and choices saved","failure_behavior":"SECTION NOT STARTED with retry","automated_test_name":"section-start-save"},
    {"button_id":"sectionPurposeNote","visible_label":"WHY I MAPPED THIS SECTION","screen":"active section","event_handler":"renderNoteEditor linked to section","required_state":"active section","disabled_state_reason":null,"expected_result":"focused section-purpose note editor","saving_behavior":"append-only section note","failure_behavior":"draft retained","automated_test_name":"section-purpose-note"},
    {"button_id":"sectionAddPhoto","visible_label":"PHOTO IN THIS SECTION","screen":"active section","event_handler":"simpleTakePhoto","required_state":"active section","disabled_state_reason":"camera/save busy only","expected_result":"photo attaches directly to section","saving_behavior":"binary read-back verification","failure_behavior":"pending-photo recovery queue","automated_test_name":"section-attachments"},
    {"button_id":"sectionAddWater","visible_label":"WATER IN THIS SECTION","screen":"active section","event_handler":"openSimpleCapture water","required_state":"active section","disabled_state_reason":null,"expected_result":"water record linked to section","saving_behavior":"feature saved before details","failure_behavior":"location limitation shown, record preserved","automated_test_name":"section-attachments"},
    {"button_id":"sectionAddTree","visible_label":"TREE IN THIS SECTION","screen":"active section","event_handler":"openSimpleCapture tree","required_state":"active section","disabled_state_reason":null,"expected_result":"tree record linked to section","saving_behavior":"tree ID saved before details","failure_behavior":"location limitation shown, record preserved","automated_test_name":"section-attachments"},
    {"button_id":"sectionPause","visible_label":"PAUSE / RESUME","screen":"active section","event_handler":"toggle capture_paused","required_state":"active section","disabled_state_reason":null,"expected_result":"large state banner changes","saving_behavior":"pause/resume event saved","failure_behavior":"prior state remains recoverable","automated_test_name":"section-pause-resume"},
    {"button_id":"sectionFinish","visible_label":"SAVE THIS SECTION","screen":"active section","event_handler":"section-purpose finish workflow","required_state":"active section","disabled_state_reason":null,"expected_result":"why-mapped note choice then finish choice","saving_behavior":"geometry and note state saved","failure_behavior":"section remains active/partial","automated_test_name":"section-finish"},
    {"button_id":"sectionCannotWalk","visible_label":"CANNOT WALK THE REST","screen":"active section","event_handler":"partial finish workflow","required_state":"active section","disabled_state_reason":null,"expected_result":"explicit partial/inferred choice","saving_behavior":"walked edge preserved separately","failure_behavior":"section remains saved active","automated_test_name":"section-partial-finish"},
    {"button_id":"sectionCorrect","visible_label":"ADD OR CORRECT DESCRIPTION","screen":"saved section","event_handler":"renderSectionCorrection","required_state":"saved section","disabled_state_reason":null,"expected_result":"append-only correction screen","saving_behavior":"original remains unchanged","failure_behavior":"original remains active","automated_test_name":"section-correction"},
    {"button_id":"simpleFinish","visible_label":"FINISH","screen":"field grid","event_handler":"renderSimpleFinish","required_state":"inspection active","disabled_state_reason":null,"expected_result":"export screen shown","saving_behavior":"inspection not cleared","failure_behavior":"return to capture available","automated_test_name":"finish-control"}
  ]
}
