{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property-intelligence-opportunity-v0.1",
  "title": "Property Intelligence Opportunity",
  "type": "object",
  "required": ["opportunity_id","property_id","created_at","opportunity_type","customer_type","evidence_basis","interpretation_basis","unknowns","required_verifications","eligible_service_codes","proposal_eligibility","priority_inputs","priority_score","priority_explanation","status","history"],
  "properties": {
    "opportunity_id": {"type":"string"},
    "property_id": {"type":"string"},
    "created_at": {"type":"string"},
    "opportunity_type": {"type":"string"},
    "customer_need": {"type":"string"},
    "customer_type": {"enum":["SELLER_LISTING_AGENT","BUYER","BUILDER","OWNER"]},
    "source_observation_ids": {"type":"array","items":{"type":"string"}},
    "source_photo_ids": {"type":"array","items":{"type":"string"}},
    "source_asset_ids": {"type":"array","items":{"type":"string"}},
    "source_proposal_zone_ids": {"type":"array","items":{"type":"string"}},
    "source_work_order_ids": {"type":"array","items":{"type":"string"}},
    "source_customer_interaction_ids": {"type":"array","items":{"type":"string"}},
    "evidence_basis": {"type":"array","items":{"type":"object"}},
    "interpretation_basis": {"type":"array","items":{"type":"object"}},
    "customer_interest_basis": {"type":"array","items":{"type":"object"}},
    "unknowns": {"type":"array","items":{"type":"string"}},
    "required_verifications": {"type":"array","items":{"type":"string"}},
    "suggested_next_investigation": {"type":"string"},
    "estimated_investigation_cost_status": {"enum":["UNKNOWN","KNOWN","NOT_APPLICABLE"]},
    "eligible_service_codes": {"type":"array","items":{"type":"string"}},
    "proposal_eligibility": {"enum":["NOT_ELIGIBLE","NEEDS_VERIFICATION","READY_FOR_DRAFT"]},
    "priority_inputs": {"type":"object"},
    "priority_score": {"type":["number","null"]},
    "priority_explanation": {"type":"string"},
    "customer_value_hypothesis": {"type":"string"},
    "business_value_hypothesis": {"type":"string"},
    "status": {"enum":["DISCOVERED","NEEDS_VERIFICATION","READY_FOR_PROPOSAL","PROPOSED","ACCEPTED","DECLINED","DEFERRED","COMPLETED","MONITORING"]},
    "history": {"type":"array","items":{"type":"object"}}
  }
}
